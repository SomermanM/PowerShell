# Fix syntax highlighting on GitHub to allow comments
.devcontainer.json linguist-language=JSON-with-Comments
devcontainer.json linguist-language=JSON-with-Comments

# Apply override to all files in the directory
*.md linguist-detectable

# Basic .gitattributes for a PowerShell repo.
# Source files
# ============
*.ps1      text eol=crlf
*.ps1x     text eol=crlf
*.psm1     text eol=crlf
*.psd1     text eol=crlf
*.ps1xml   text eol=crlf
*.pssc     text eol=crlf
*.psrc     text eol=crlf
*.cdxml    text eol=crlf

# Fix syntax highlighting on GitHub to allow comments
.vscode/*.json linguist-language=JSON-with-Comments

CMD/*.cmd text eol=crlf
"Canned Script/*.txt" text eol=crlf
"Command Sequence/*.txt" text eol=crlf
"Canned Script/*.reg" -text
CMD/Configure-ChromeSettings.cmd -text -eol
CMD/Configure-EdgeSettings.cmd -text -eol
"Command Sequence/Configure-ChromeSettings.txt" -text -eol
"Command Sequence/Configure-EdgeSettings.txt" -text -eol
CMD/Set-BlockNtlmv1SSO-Audit.cmd -text -eol
"Canned Script/Set-BlockNtlmv1SSO-Audit.txt" -text -eol
